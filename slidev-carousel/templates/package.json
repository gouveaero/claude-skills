{
  "name": "carousel",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export --format png --output ./exports/",
    "export-jpg": "slidev export --format png --output ./exports/ && for f in ./exports/*.png; do sips -s format jpeg \"$f\" --out \"${f%.png}.jpg\" >/dev/null && rm \"$f\"; done"
  },
  "dependencies": {
    "@slidev/cli": "^0.50.0",
    "@slidev/theme-default": "*",
    "@iconify-json/mdi": "^1.2.0",
    "@iconify-json/heroicons": "^1.2.0",
    "@vueuse/motion": "^2.2.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.49.0"
  }
}
