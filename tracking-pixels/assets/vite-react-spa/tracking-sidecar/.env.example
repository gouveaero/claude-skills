# tracking-sidecar — server-only secrets
#
# Deploy as a SEPARATE Coolify app from the main Vite site.
# Set all these in Coolify → <client>-tracking → Environment Variables.

# ─── Required ─────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=https://YOUR-PRIMARY-DOMAIN     # the Vite SPA's URL — must allowlist exactly

# ─── Meta ─────────────────────────────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=v25.0
META_TEST_EVENT_CODE=                        # leave empty in prod

# ─── GA4 ──────────────────────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=G-
GA4_API_SECRET=
GA4_REGION=us
DEBUG_GA4=                                   # set '1' during dev, empty in prod

# ─── TikTok ───────────────────────────────────────────────────────────────────
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=                      # leave empty in prod
