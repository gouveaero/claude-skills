# tracking-pixels (Vite SPA) — env vars
#
# Vite only exposes VITE_-prefixed vars to the client bundle.
# Server-only secrets live in tracking-sidecar/.env (separate file, separate Coolify app).

# ─── Client bundle (VITE_*) ───────────────────────────────────────────────────
VITE_META_PIXEL_ID=
VITE_GA4_MEASUREMENT_ID=G-
VITE_GOOGLE_ADS_CONVERSION_ID=AW-
VITE_GADS_LABEL_LEAD=
VITE_GADS_LABEL_INITIATECHECKOUT=
VITE_GADS_LABEL_SCHEDULE=
# VITE_GADS_LABEL_PURCHASE=  # opt-in only — purchases normally fire on the checkout platform (Hotmart/Eduzz/Kiwify), not the site
VITE_TIKTOK_PIXEL_ID=

# Sidecar endpoint — the Coolify app that runs tracking-sidecar/server.ts
VITE_TRACKING_ENDPOINT=https://track.YOUR-DOMAIN/api/track
