# tracking-pixels — env vars
#
# After filling .env.local locally, replicate these in Coolify:
#   Coolify → app → Environment Variables → Add (for each)
#   Mark "Is Build Time?" for NEXT_PUBLIC_* vars only.
#
# NEVER commit values. .env.local is gitignored.

# ─── Meta (Pixel + CAPI) ──────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=                     # same value, server-readable
META_CAPI_TOKEN=                   # Events Manager → Settings → CAPI → Generate Token
META_GRAPH_VERSION=v24.0           # https://developers.facebook.com/docs/graph-api/changelog/versions/
META_TEST_EVENT_CODE=              # ONLY during testing — leave empty in prod

# ─── Google Ads (Enhanced Conversions for Web via gtag) ───────────────────────
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-
# One env var per event conversion label — e.g. NEXT_PUBLIC_GADS_LABEL_LEAD=abc/xyz
NEXT_PUBLIC_GADS_LABEL_LEAD=
NEXT_PUBLIC_GADS_LABEL_PURCHASE=
NEXT_PUBLIC_GADS_LABEL_SCHEDULE=

# ─── GA4 (Measurement Protocol) ───────────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-
GA4_API_SECRET=                    # GA4 Admin → Data Streams → MP API secrets → Create
GA4_REGION=us                      # 'us' or 'eu' (eu uses region1.google-analytics.com)
DEBUG_GA4=                         # set to '1' during dev to enable DebugView; leave empty in prod

# ─── TikTok (Events API 2.0) ──────────────────────────────────────────────────
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_PIXEL_ID=                   # same value, server-readable
TIKTOK_ACCESS_TOKEN=               # Events Manager → Settings → Generate Access Token
TIKTOK_TEST_EVENT_CODE=            # ONLY during testing — leave empty in prod

# ─── Tracking endpoint override (rarely needed) ───────────────────────────────
NEXT_PUBLIC_TRACKING_ENDPOINT=/api/track
